__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

data/raw/
data/bronze/
data/silver/
data/gold/
*.duckdb
*.db

.fastf1_cache/
mlruns/
mlartifacts/
mlflow.db
catboost_info/

.git/
.github/
docs/
tests/
*.md

.env
.env.*
!.env.example
