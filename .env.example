# Copy to .env and adjust as needed. Every value here has a working
# default in ingestion/config.py — you only need this file to override one.

# Where the Raw Layer lands on disk (default: ./data/raw)
# RACEIQ_DATA_ROOT=./data/raw

# FastF1's own response cache (default: ./.fastf1_cache)
# FASTF1_CACHE_DIR=./.fastf1_cache

# Ergast-schema API. Original ergast.com is being deprecated; default here
# is the Jolpica-F1 community mirror, which serves the same schema.
# ERGAST_BASE_URL=https://api.jolpi.ca/ergast/f1

# OPENF1_BASE_URL=https://api.openf1.org/v1

# Open-Meteo historical weather archive (free, keyless).
# WEATHER_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# RACEIQ_REQUEST_TIMEOUT=30
# RACEIQ_MAX_RETRIES=3
